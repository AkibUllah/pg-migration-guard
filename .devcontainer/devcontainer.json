{
  "name": "pg-migration-guard",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "python3 -m venv .venv && .venv/bin/pip install -e '.[dev]'",
  "postStartCommand": "docker compose up -d shadow",
  "containerEnv": {
    "PGMG_DSN": "postgresql://postgres:pgmg@localhost:55432/pgmg_shadow"
  },
  "forwardPorts": [55432],
  "portsAttributes": {
    "55432": { "label": "Shadow PostgreSQL", "onAutoForward": "silent" }
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "charliermarsh.ruff"] }
  }
}
